# Example environment variables for test-paint-events.ts

# Your private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Network to test on: 'production' or 'staging'
NETWORK=production

# Number of transactions to send (default: 100)
NUM_TRANSACTIONS=100

# Delay between sending transactions in milliseconds (default: 50)
# Lower values = more aggressive parallel sending
DELAY_BETWEEN_TXS=50